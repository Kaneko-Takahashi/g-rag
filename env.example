# G-RAG Configuration
# 本番では .env を必ず設定し、JWT_SECRET は 32 文字以上のランダム文字列にすること。

# --- Environment ---
# development | production
NODE_ENV=development
LOG_LEVEL=INFO

# --- Auth ---
# demo | supabase | github
AUTH_MODE=demo

# 本番必須: 32文字以上の強力な秘密鍵（openssl rand -hex 32 で生成推奨）
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Supabase（AUTH_MODE=supabase 時）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# GitHub OAuth（AUTH_MODE=github 時）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# --- API ---
API_PORT=8000
API_HOST=0.0.0.0

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Embedding ---
# demo | real
EMBEDDING_MODE=demo

# OpenAI（REALモード用）
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- RAG ---
DEFAULT_TOP_K=4
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# --- Vector DB ---
# memory | chroma（memory=メモリ内 numpy、chroma=ChromaDB 永続化）
VECTOR_DB=memory
CHROMA_PERSIST_DIR=./data/chroma

# --- Cache ---
CACHE_SIZE=1000
CACHE_TTL_SECONDS=3600

# --- Database ---
# 開発: SQLite  本番: Postgres 推奨（docker-compose.prod 利用時は POSTGRES_* で自動設定）
# postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/grag.db

# Postgres（本番 Docker 用）
POSTGRES_USER=grag
POSTGRES_PASSWORD=
POSTGRES_DB=grag

# --- Rate Limit ---
# 1分あたりのリクエスト数上限（0=無制限）
RATE_LIMIT_PER_MINUTE=60

# --- CORS（本番で Web のオリジンを追加）---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
